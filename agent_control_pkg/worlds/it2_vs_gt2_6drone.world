<?xml version="1.0" ?>
<!--
  IT2 vs GT2 Fuzzy Controller Comparison World
  6 Crazyflie 2.1 drones for direct IT2-FLS vs GT2-FLS comparison

  Groups:
  - Group 0 (agent_0,1,2): PID+IT2-FLS - Y=-10m
  - Group 1 (agent_3,4,5): PID+GT2-FLS - Y=10m

  Physical Model: Crazyflie 2.1
  - Mass: 27g (0.027 kg)
  - Size: 92mm x 92mm
  - Max thrust: ~60g (0.6N)
  - Motor model: sim_cf2 dynamics
-->
<sdf version="1.6">
  <world name="it2_vs_gt2_comparison">

    <!-- Physics Configuration for small quadrotors -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Gazebo-ROS2 Integration -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <!-- Environment -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ========================================= -->
    <!-- GROUP 0: PID+IT2-FLS Controllers -->
    <!-- Y = -10m lane -->
    <!-- ========================================= -->

    <model name="agent_0">
      <pose>-12 -10 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_0</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_1">
      <pose>-8 -10 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_1</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_2">
      <pose>-4 -10 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_2</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <!-- ========================================= -->
    <!-- GROUP 1: PID+GT2-FLS Controllers -->
    <!-- Y = 10m lane -->
    <!-- ========================================= -->

    <model name="agent_3">
      <pose>-12 10 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_3</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_4">
      <pose>-8 10 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_4</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_5">
      <pose>-4 10 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_5</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <!-- Target Markers -->
    <include>
      <uri>model://checkpoint_marker</uri>
      <name>target_it2</name>
      <pose>10 -10 0.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://checkpoint_marker</uri>
      <name>target_gt2</name>
      <pose>10 10 0.5 0 0 0</pose>
    </include>

  </world>
</sdf>
