<?xml version="1.0"?>
<sdf version="1.6">
  <world name="thesis_multi_drone_world">

    <!-- Optimized physics for high FPS with multiple drones -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Simple ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drone 0: P-only controller (Red) -->
    <model name="agent_0">
      <pose>0 0 0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <visual name="body">
          <geometry>
            <sphere><radius>0.12</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.9 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="arm_x">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <visual name="arm_y">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <sphere><radius>0.2</radius></sphere>
          </geometry>
        </collision>
      </link>

      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_0</namespace>
      </plugin>
    </model>

    <!-- Drone 1: PI controller (Green) -->
    <model name="agent_1">
      <pose>0 2 0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <visual name="body">
          <geometry>
            <sphere><radius>0.12</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.2 0.9 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="arm_x">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <visual name="arm_y">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <sphere><radius>0.2</radius></sphere>
          </geometry>
        </collision>
      </link>

      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_1</namespace>
      </plugin>
    </model>

    <!-- Drone 2: PD controller (Blue) -->
    <model name="agent_2">
      <pose>0 4 0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <visual name="body">
          <geometry>
            <sphere><radius>0.12</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.2 0.2 0.9 1</diffuse>
          </material>
        </visual>

        <visual name="arm_x">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <visual name="arm_y">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <sphere><radius>0.2</radius></sphere>
          </geometry>
        </collision>
      </link>

      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_2</namespace>
      </plugin>
    </model>

    <!-- Drone 3: PID controller (Yellow) -->
    <model name="agent_3">
      <pose>0 6 0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <visual name="body">
          <geometry>
            <sphere><radius>0.12</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.1 1</ambient>
            <diffuse>0.9 0.9 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="arm_x">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <visual name="arm_y">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <sphere><radius>0.2</radius></sphere>
          </geometry>
        </collision>
      </link>

      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_3</namespace>
      </plugin>
    </model>

    <!-- Drone 4: PID+Fuzzy controller (Magenta) -->
    <model name="agent_4">
      <pose>0 8 0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <visual name="body">
          <geometry>
            <sphere><radius>0.12</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.8 1</ambient>
            <diffuse>0.9 0.2 0.9 1</diffuse>
          </material>
        </visual>

        <visual name="arm_x">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <visual name="arm_y">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.02</radius><length>0.6</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <sphere><radius>0.2</radius></sphere>
          </geometry>
        </collision>
      </link>

      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_4</namespace>
      </plugin>
    </model>

  </world>
</sdf>
