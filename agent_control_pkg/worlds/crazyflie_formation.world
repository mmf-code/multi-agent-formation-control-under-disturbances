<?xml version="1.0" ?>
<!--
  Crazyflie Formation World
  9 Crazyflie 2.1 drones in 3 groups for controller comparison

  Groups:
  - Group 0 (agent_0,1,2): PID+Fuzzy - Y=-15, Z=0.5m
  - Group 1 (agent_3,4,5): PD - Y=0, Z=0.5m
  - Group 2 (agent_6,7,8): PID - Y=15, Z=0.5m

  Physical Model: Crazyflie 2.1
  - Mass: 27g (0.027 kg)
  - Size: 92mm x 92mm
  - Max thrust: ~60g (0.6N)
-->
<sdf version="1.6">
  <world name="crazyflie_formation">

    <!-- Physics Configuration for small quadrotors -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Gazebo-ROS2 Integration -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <!-- Environment -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Wind is handled by ROS2 wind_publisher node -->
    <!-- Launch with: ros2 run agent_control_pkg wind_publisher.py -->
    <!-- Publishes to /wind/velocity which simple_drone_plugin subscribes to -->

    <!-- ========================================= -->
    <!-- GROUP 0: PID+Fuzzy Controllers (Cyan) -->
    <!-- Y = -15m lane -->
    <!-- ========================================= -->

    <model name="agent_0">
      <pose>-15 -15 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_0</namespace>
        <target_altitude>0.5</target_altitude>
        <!-- Crazyflie physics parameters -->
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <model name="agent_1">
      <pose>-12 -15 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_1</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <model name="agent_2">
      <pose>-9 -15 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_2</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <!-- ========================================= -->
    <!-- GROUP 1: PD Controllers (Blue) -->
    <!-- Y = 0m lane -->
    <!-- ========================================= -->

    <model name="agent_3">
      <pose>-15 0 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_3</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <model name="agent_4">
      <pose>-12 0 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_4</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <model name="agent_5">
      <pose>-9 0 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_5</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <!-- ========================================= -->
    <!-- GROUP 2: PID Controllers (Red) -->
    <!-- Y = 15m lane -->
    <!-- ========================================= -->

    <model name="agent_6">
      <pose>-15 15 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_6</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <model name="agent_7">
      <pose>-12 15 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_7</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <model name="agent_8">
      <pose>-9 15 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_8</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <!-- HIGH sensor noise for IT2-FLS FOU advantage testing -->
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <!-- Motor model feature flag (false=legacy F=ma, true=sim_cf2 motor) -->
        <use_motor_model>false</use_motor_model>
      </plugin>
    </model>

    <!-- Target Markers -->
    <include>
      <uri>model://checkpoint_marker</uri>
      <name>target_0</name>
      <pose>0 -15 0.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://checkpoint_marker</uri>
      <name>target_1</name>
      <pose>0 0 0.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://checkpoint_marker</uri>
      <name>target_2</name>
      <pose>0 15 0.5 0 0 0</pose>
    </include>

  </world>
</sdf>
