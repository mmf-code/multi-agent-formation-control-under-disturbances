    <!-- Drone 5: PD (Group 1 color unified: Red) -->
    <model name="agent_5">
      <pose>-8.5 1.5 3.0 0 0 0</pose>  <!-- Top vertex (Group 1, Z=3.0m EQUAL HEIGHT) -->
      <static>false</static>

      <link name="base_link">
