<?xml version="1.0"?>
<sdf version="1.6">
  <world name="formation_comparison_world">

    <!-- Optimized physics for high FPS with 9 drones -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>5.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Wind Model: Strong wind disturbance for controller comparison -->
    <!-- Stronger wind ensures PID+Fuzzy advantage is visible -->
    <plugin name="wind_plugin" filename="libgazebo_ros_wind.so">
      <ros>
        <!-- Namespace chosen so that the plugin publishes under /wind/... topics.
             The controller node defaults to wind_source_topic=/wind/velocity. -->
        <namespace>/wind</namespace>
      </ros>
      <frame_id>world</frame_id>
      <wind_direction>
        <!-- Crosswind dominant (north-bound), minimal forward push -->
        <x>0.1</x>
        <y>1.0</y>
        <z>0.0</z>
      </wind_direction>
      <!-- Increased mean/variance further to make controller differences visually obvious. -->
      <wind_force_mean>8.0</wind_force_mean>
      <wind_force_variance>3.0</wind_force_variance>
      <update_rate>10.0</update_rate>
    </plugin>

    <!-- Ground plane -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Asphalt</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================= -->
    <!-- GROUP 0: PID+Fuzzy Controllers (Cyan/Magenta/Yellow) -->
    <!-- Lane: Y=-4, Triangle formation -->
    <!-- ========================================= -->

    <!-- Drone 0: PID+Fuzzy (Cyan) -->
    <model name="agent_0">
      <pose>-15 -15.0 3.0 0 0 0</pose>  <!-- Group 0 LEFT (y=-15) -->
      <static>false</static>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <!-- Body: Sleek dark grey box -->
        <visual name="body">
          <geometry>
            <box><size>0.3 0.1 0.05</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>

        <!-- Arms: X-configuration -->
        <visual name="arm1">
          <pose>0.1 0.1 0 0 0 0.785</pose>
          <geometry><box><size>0.25 0.02 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="arm2">
          <pose>-0.1 0.1 0 0 0 -0.785</pose>
          <geometry><box><size>0.25 0.02 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="arm3">
          <pose>0.1 -0.1 0 0 0 -0.785</pose>
          <geometry><box><size>0.25 0.02 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="arm4">
          <pose>-0.1 -0.1 0 0 0 0.785</pose>
          <geometry><box><size>0.25 0.02 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <!-- Group Indicator: Cyan Neon (Emissive) -->
        <visual name="indicator">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.01</size></box></geometry>
          <material>
            <ambient>0 1 1 1</ambient>
            <diffuse>0 1 1 1</diffuse>
            <emissive>0 1 1 1</emissive>
          </material>
        </visual>

        <!-- Propellers -->
        <visual name="prop_fl"><pose>0.15 0.15 0.02 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="prop_fr"><pose>0.15 -0.15 0.02 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="prop_rl"><pose>-0.15 0.15 0.02 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="prop_rr"><pose>-0.15 -0.15 0.02 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>

        <collision name="collision">
          <geometry>
            <box><size>0.4 0.4 0.1</size></box>
          </geometry>
        </collision>
      </link>

      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_0</namespace>
        <target_altitude>3.0</target_altitude>
      </plugin>
    </model>

    <!-- Drone 1: PID+Fuzzy (Group 0 color unified: Cyan) -->
    <model name="agent_1">
      <pose>-12 -15.0 3.0 0 0 0</pose>  <!-- Group 0 LEFT (y=-15) -->
