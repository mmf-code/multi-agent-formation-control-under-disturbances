    <!-- ===== Visual Aids: Wind + Checkpoints ===== -->
    <!-- Wind direction indicator (approx yaw atan2(0.3,1.0)=0.291 rad) -->
    <include>
      <uri>model://wind_indicator</uri>
      <name>wind_indicator</name>
      <pose>0 0 0 0 0 0.291</pose>
    </include>

    <!-- Group 0 Checkpoints -->
