    <!-- ========================================= -->
    <!-- VISUAL ENHANCEMENTS FOR VIDEO DEMO -->
    <!-- ========================================= -->

    <!-- ===== FIGURE-8 GROUND PATH MARKERS ===== -->
    <!-- Each group has colored ground markers showing trajectory -->

    <!-- Group 0 (PD) Path Markers - RED - Y=-12m -->
    <model name="path_pd_center">
      <static>true</static>
      <pose>0 -12 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.2 0.2 0.8</ambient><diffuse>1 0.2 0.2 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="path_pd_right">
      <static>true</static>
      <pose>6 -12 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.2 0.2 0.6</ambient><diffuse>1 0.2 0.2 0.6</diffuse></material>
