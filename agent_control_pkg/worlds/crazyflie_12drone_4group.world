<?xml version="1.0" ?>
<!--
  12-Drone 4-Group Controller Comparison World
  Crazyflie 2.1 drones in 4 groups for PD vs PID vs IT2 vs GT2 comparison

  Groups (3 drones each):
  - Group 0 (agents 0-2): PD Controller - Y=-12m
  - Group 1 (agents 3-5): PID Controller - Y=-4m
  - Group 2 (agents 6-8): PID+IT2-Fuzzy - Y=4m
  - Group 3 (agents 9-11): PID+GT2-Fuzzy - Y=12m

  Physical Model: Crazyflie 2.1
  - Mass: 27g (0.027 kg)
  - Size: 92mm x 92mm
  - Max thrust: ~60g (0.6N)
-->
<sdf version="1.6">
  <world name="twelve_drone_4group_comparison">

    <!-- Physics Configuration for small quadrotors -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Gazebo-ROS2 Integration -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <!-- Environment -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ========================================= -->
    <!-- GROUP 0: PD Controllers (agents 0-2) -->
    <!-- Y = -12m lane -->
    <!-- ========================================= -->

    <model name="agent_0">
      <pose>0 -10.3 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_0</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_1">
      <pose>-1.5 -12.9 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_1</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_2">
      <pose>1.5 -12.9 0.5 0 0 0</pose>
      <include>
        <uri>model://crazyflie</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_2</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

