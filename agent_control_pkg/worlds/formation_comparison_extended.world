<?xml version="1.0"?>
<sdf version="1.6">
  <world name="formation_comparison_extended">

    <!-- Physics settings -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Wind plugin - INCREASED for extended scenario -->
    <plugin name="wind_plugin" filename="libgazebo_wind_plugin.so">
      <frameId>world</frameId>
      <robotNamespace></robotNamespace>
      <xyzOffset>0 0 0</xyzOffset>
      <windDirectionMean>0 1 0</windDirectionMean>
      <windVelocityMean>0.0</windVelocityMean>
      <windGustDirection>0 1 0</windGustDirection>
      <windGustDuration>5</windGustDuration>
      <windGustStart>0</windGustStart>
      <windGustVelocityMean>0.0</windGustVelocityMean>
      <windPubTopic>wind</windPubTopic>
      <windForcePubTopic>wind/force</windForcePubTopic>
      <wind_force_mean>6.0</wind_force_mean>
      <wind_force_variance>2.0</wind_force_variance>
      <updateRate>10.0</updateRate>
    </plugin>

    <!-- GROUP 0: PID+Fuzzy (3 drones) - Bottom lane, EXTENDED starting position -->
    <model name="agent_0">
      <pose>-30 -5.5 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_0</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <model name="agent_1">
      <pose>-30 -3.0 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_1</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <model name="agent_2">
      <pose>-30 -4.2 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_2</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <!-- GROUP 1: PD (3 drones) - Middle lane -->
    <model name="agent_3">
      <pose>-25 -1.0 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_3</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <model name="agent_4">
      <pose>-25 1.5 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_4</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <model name="agent_5">
      <pose>-25 0.3 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_5</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <!-- GROUP 2: PID (3 drones) - Top lane -->
    <model name="agent_6">
      <pose>-20 3.5 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_6</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <model name="agent_7">
      <pose>-20 6.0 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_7</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

    <model name="agent_8">
      <pose>-20 4.8 0.5 0 0 0</pose>
      <include>
        <uri>model://simple_drone</uri>
      </include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <robotNamespace>agent_8</robotNamespace>
        <updateRate>200.0</updateRate>
      </plugin>
    </model>

  </world>
</sdf>
