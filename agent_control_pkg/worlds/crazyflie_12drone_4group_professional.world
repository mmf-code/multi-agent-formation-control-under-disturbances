    <!-- Group 3 (GT2) - BLUE figure-8 path at Y=12 -->
    <model name="traj_gt2">
      <static>true</static>
      <link name="path">
        <visual name="r0"><pose>0 12 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.2 0.4 1 0.9</ambient><diffuse>0.3 0.5 1 0.9</diffuse></material></visual>
        <visual name="r1"><pose>3 14.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.3 0.5 1 0.7</ambient><diffuse>0.4 0.6 1 0.7</diffuse></material></visual>
        <visual name="r2"><pose>6 12 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.2 0.4 1 0.8</ambient><diffuse>0.3 0.5 1 0.8</diffuse></material></visual>
        <visual name="r3"><pose>3 9.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.3 0.5 1 0.7</ambient><diffuse>0.4 0.6 1 0.7</diffuse></material></visual>
        <visual name="l1"><pose>-3 9.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
