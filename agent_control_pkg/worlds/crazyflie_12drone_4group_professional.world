    <!-- ========================================= -->
    <!-- FIGURE-8 TRAJECTORY PATH MARKERS -->
    <!-- Continuous curved path visualization -->
    <!-- ========================================= -->

    <!-- Group 0 (PD) - RED figure-8 path at Y=-12 -->
    <model name="traj_pd">
      <static>true</static>
      <link name="path">
        <visual name="seg0"><pose>0.488 -11.522 0.015 0 0 0.7757</pose>
          <geometry><box><size>1.366 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg1"><pose>1.444 -10.638 0.015 0 0 0.7130</pose>
          <geometry><box><size>1.240 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg2"><pose>2.346 -9.961 0.015 0 0 0.5600</pose>
          <geometry><box><size>1.020 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg3"><pose>3.157 -9.595 0.015 0 0 0.2461</pose>
          <geometry><box><size>0.781 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg4"><pose>3.846 -9.595 0.015 0 0 -0.2970</pose>
          <geometry><box><size>0.650 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg5"><pose>4.388 -9.961 0.015 0 0 -0.8648</pose>
          <geometry><box><size>0.712 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg6"><pose>4.762 -10.638 0.015 0 0 -1.2334</pose>
          <geometry><box><size>0.860 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg7"><pose>4.952 -11.522 0.015 0 0 -1.4707</pose>
          <geometry><box><size>0.962 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg8"><pose>4.952 -12.478 0.015 0 0 -1.6709</pose>
          <geometry><box><size>0.962 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg9"><pose>4.762 -13.362 0.015 0 0 -1.9082</pose>
          <geometry><box><size>0.860 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg10"><pose>4.388 -14.039 0.015 0 0 -2.2768</pose>
          <geometry><box><size>0.712 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg11"><pose>3.846 -14.405 0.015 0 0 -2.8446</pose>
          <geometry><box><size>0.650 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg12"><pose>3.157 -14.405 0.015 0 0 2.8955</pose>
          <geometry><box><size>0.781 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg13"><pose>2.346 -14.039 0.015 0 0 2.5816</pose>
          <geometry><box><size>1.020 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg14"><pose>1.444 -13.362 0.015 0 0 2.4286</pose>
          <geometry><box><size>1.240 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg15"><pose>0.488 -12.478 0.015 0 0 2.3659</pose>
          <geometry><box><size>1.366 0.12 0.015</size></box></geometry>
          <material><ambient>1 0.3 0.3 0.85</ambient><diffuse>1 0.4 0.4 0.85</diffuse></material></visual>
        <visual name="seg16"><pose>-0.488 -11.522 0.015 0 0 2.3659</pose>
