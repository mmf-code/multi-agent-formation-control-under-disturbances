<?xml version="1.0" ?>
<!--
  Professional 12-Drone 4-Group Controller Comparison World
  Robotics Arena Style Environment for Video Demo

  Groups (3 drones each):
  - Group 0 (agents 0-2): PD Controller - Y=-12m (RED)
  - Group 1 (agents 3-5): PID Controller - Y=-4m (ORANGE)
  - Group 2 (agents 6-8): PID+IT2-Fuzzy - Y=4m (GREEN)
  - Group 3 (agents 9-11): PID+GT2-Fuzzy - Y=12m (BLUE)

  Features:
  - Grid textured ground plane (1m squares, 4m major lines)
  - Dynamic wind flag (rotates based on /wind/velocity)
  - Helipad landing zones for each group
  - Figure-8 trajectory path markers
  - Professional arena boundary markers
  - Controller group identification posts
-->
<sdf version="1.6">
  <world name="professional_formation_arena">

    <!-- Physics Configuration for Crazyflie 2.1 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Gazebo-ROS2 Integration -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so">
      <ros><namespace>/</namespace></ros>
    </plugin>
    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros><namespace>/</namespace></ros>
    </plugin>

    <!-- ========================================= -->
    <!-- ENVIRONMENT -->
    <!-- ========================================= -->

    <!-- Sun with better lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.4 -1.0</direction>
    </light>

    <!-- Ambient light for better visibility -->
    <light name="ambient" type="point">
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>200</range>
        <constant>0.3</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Sky -->
    <scene>
      <ambient>0.4 0.4 0.45 1</ambient>
      <background>0.5 0.6 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Professional Arena Ground -->
    <include>
      <uri>model://arena_ground</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ========================================= -->
    <!-- DYNAMIC WIND INDICATOR -->
    <!-- Rotates based on /wind/velocity ROS2 topic -->
    <!-- ========================================= -->

    <model name="wind_indicator">
      <static>false</static>
      <pose>15 0 0 0 0 0</pose>

      <!-- Fixed base/pole -->
      <link name="base">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>100</mass>
          <inertia>
            <ixx>100</ixx><iyy>100</iyy><izz>100</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="pole">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <visual name="base_plate">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="base_collision">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>

      <!-- Rotating windsock -->
      <link name="flag">
        <pose>0 0 3.8 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.1</iyy><izz>0.1</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- Windsock segments - orange/white stripes -->
        <visual name="sock_1">
          <pose>0.3 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>1 0.4 0 1</ambient><diffuse>1 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="sock_2">
          <pose>0.6 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="sock_3">
          <pose>0.85 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1 0.4 0 1</ambient><diffuse>1 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="sock_4">
          <pose>1.1 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="sock_tip">
          <pose>1.3 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>1 0.3 0 1</ambient><diffuse>1 0.4 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Revolute joint for yaw rotation -->
      <joint name="flag_joint" type="revolute">
        <parent>base</parent>
        <child>flag</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-3.15</lower><upper>3.15</upper></limit>
          <dynamics><damping>0.5</damping></dynamics>
        </axis>
      </joint>

      <!-- Wind flag plugin - subscribes to /wind/velocity -->
      <plugin name="wind_flag_plugin" filename="libwind_flag_plugin.so">
        <joint_name>flag_joint</joint_name>
        <wind_topic>/wind/velocity</wind_topic>
        <update_rate>10</update_rate>
      </plugin>
    </model>

    <!-- Landing pads removed - formation triangle outlines are clearer -->

    <!-- ========================================= -->
    <!-- GROUP 0: PD Controllers (agents 0-2) -->
    <!-- Y = -12m lane - RED -->
    <!-- ========================================= -->

    <model name="agent_0">
      <pose>-4 -12 0.5 0 0 0</pose>
      <include><uri>model://crazyflie</uri></include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_0</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_1">
      <pose>0 -12 0.5 0 0 0</pose>
      <include><uri>model://crazyflie</uri></include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_1</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <model name="agent_2">
      <pose>4 -12 0.5 0 0 0</pose>
      <include><uri>model://crazyflie</uri></include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_2</namespace>
        <target_altitude>0.5</target_altitude>
        <actuator_tau_up>0.0125</actuator_tau_up>
        <actuator_tau_down>0.025</actuator_tau_down>
        <max_accel>17.0</max_accel>
        <drag_coeff_lin>0.003</drag_coeff_lin>
        <drag_coeff_quad>0.0008</drag_coeff_quad>
        <drag_speed_threshold>0.5</drag_speed_threshold>
        <position_noise_std>0.10</position_noise_std>
        <velocity_noise_std>0.15</velocity_noise_std>
        <use_motor_model>true</use_motor_model>
      </plugin>
    </model>

    <!-- ========================================= -->
    <!-- GROUP 1: PID Controllers (agents 3-5) -->
    <!-- Y = -4m lane - ORANGE -->
    <!-- ========================================= -->

    <model name="agent_3">
      <pose>-4 -4 0.5 0 0 0</pose>
      <include><uri>model://crazyflie</uri></include>
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
