    <!-- ========================================= -->
    <!-- FIGURE-8 TRAJECTORY PATH MARKERS -->
    <!-- Continuous curved path visualization -->
    <!-- ========================================= -->

    <!-- Group 0 (PD) - RED figure-8 path at Y=-12 -->
    <model name="traj_pd">
      <static>true</static>
      <link name="path">
        <!-- Right loop markers -->
        <visual name="r0"><pose>0 -12 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.2 0.2 0.9</ambient><diffuse>1 0.3 0.3 0.9</diffuse></material></visual>
        <visual name="r1"><pose>3 -9.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.3 0.3 0.7</ambient><diffuse>1 0.4 0.4 0.7</diffuse></material></visual>
        <visual name="r2"><pose>6 -12 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.2 0.2 0.8</ambient><diffuse>1 0.3 0.3 0.8</diffuse></material></visual>
        <visual name="r3"><pose>3 -14.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.3 0.3 0.7</ambient><diffuse>1 0.4 0.4 0.7</diffuse></material></visual>
        <!-- Left loop markers -->
        <visual name="l1"><pose>-3 -14.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.3 0.3 0.7</ambient><diffuse>1 0.4 0.4 0.7</diffuse></material></visual>
        <visual name="l2"><pose>-6 -12 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.2 0.2 0.8</ambient><diffuse>1 0.3 0.3 0.8</diffuse></material></visual>
        <visual name="l3"><pose>-3 -9.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.3 0.3 0.7</ambient><diffuse>1 0.4 0.4 0.7</diffuse></material></visual>
      </link>
    </model>

    <!-- Group 1 (PID) - ORANGE figure-8 path at Y=-4 -->
    <model name="traj_pid">
      <static>true</static>
      <link name="path">
        <visual name="r0"><pose>0 -4 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.5 0 0.9</ambient><diffuse>1 0.6 0.1 0.9</diffuse></material></visual>
        <visual name="r1"><pose>3 -1.5 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.6 0.1 0.7</ambient><diffuse>1 0.7 0.2 0.7</diffuse></material></visual>
        <visual name="r2"><pose>6 -4 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.5 0 0.8</ambient><diffuse>1 0.6 0.1 0.8</diffuse></material></visual>
