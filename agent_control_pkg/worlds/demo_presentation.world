<?xml version="1.0"?>
<sdf version="1.6">
  <world name="formation_demo_world">

    <!-- Physics Configuration for Accurate Simulation -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Scene Lighting -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- Sun (Primary Light Source) -->
    <light name="sun" type="directional">
      <pose>5 5 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 -0.5 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Ambient Fill Light -->
    <light name="ambient_light" type="point">
      <pose>-5 -5 5 0 0 0</pose>
      <diffuse>0.3 0.3 0.3 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>50</range>
        <linear>0.01</linear>
        <constant>0.5</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Professional Grid Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Origin Marker (World Coordinate Frame) -->
    <model name="origin_marker">
      <pose>0 0 0.01 0 0 0</pose>
      <static>true</static>
      <!-- X Axis (Red) -->
      <link name="x_axis">
        <visual name="x_arrow">
          <pose>0.5 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.5 0 0 1</emissive>
          </material>
        </visual>
      </link>
      <!-- Y Axis (Green) -->
      <link name="y_axis">
        <visual name="y_arrow">
          <pose>0 0.5 0 0 0 1.5708</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <emissive>0 0.5 0 1</emissive>
          </material>
        </visual>
      </link>
      <!-- Z Axis (Blue) -->
      <link name="z_axis">
        <visual name="z_arrow">
          <pose>0 0 0.5 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <emissive>0 0 0.5 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Reference Grid Lines (1m spacing) -->
    <model name="grid_lines">
      <pose>0 0 0.005 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <!-- Grid lines visual representation -->
        <visual name="grid">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://grid_plane/materials/scripts</uri>
              <uri>model://grid_plane/materials/textures</uri>
              <name>GridPlane/Grid</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Scale Reference Markers (1m, 2m, 5m circles) -->
    <model name="scale_1m">
      <pose>0 0 0.01 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="circle">
          <geometry>
            <cylinder>
              <radius>1.0</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 0.3</ambient>
            <diffuse>0.8 0.8 0.8 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="scale_2m">
      <pose>0 0 0.01 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="circle">
          <geometry>
            <cylinder>
              <radius>2.0</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 0.2</ambient>
            <diffuse>0.7 0.7 0.7 0.2</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="scale_5m">
      <pose>0 0 0.01 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="circle">
          <geometry>
            <cylinder>
              <radius>5.0</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 0.15</ambient>
            <diffuse>0.6 0.6 0.6 0.15</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Quadrotor Drone Model (Agent 0) -->
    <model name="agent_0">
      <pose>0 0 0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <!-- Central Body (Sphere) -->
        <visual name="body">
          <geometry>
            <sphere>
              <radius>0.12</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1</ambient>
            <diffuse>0.1 0.4 0.9 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>

        <!-- Quadrotor Arms (X Configuration) -->
        <visual name="arm_x_positive">
          <pose>0.15 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="arm_x_negative">
          <pose>-0.15 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="arm_y_positive">
          <pose>0 0.15 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="arm_y_negative">
          <pose>0 -0.15 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <!-- Rotor Discs (Color-coded for orientation) -->
        <!-- Front (Red) -->
        <visual name="rotor_front">
          <pose>0.3 0 0.03 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 0.8</ambient>
            <diffuse>1.0 0.2 0.2 0.8</diffuse>
            <emissive>0.3 0 0 1</emissive>
          </material>
        </visual>
        <!-- Back (Red) -->
        <visual name="rotor_back">
          <pose>-0.3 0 0.03 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 0.8</ambient>
            <diffuse>1.0 0.2 0.2 0.8</diffuse>
            <emissive>0.3 0 0 1</emissive>
          </material>
        </visual>
        <!-- Left (Green) -->
        <visual name="rotor_left">
          <pose>0 0.3 0.03 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 0.8</ambient>
            <diffuse>0.2 1.0 0.2 0.8</diffuse>
            <emissive>0 0.3 0 1</emissive>
          </material>
        </visual>
        <!-- Right (Green) -->
        <visual name="rotor_right">
          <pose>0 -0.3 0.03 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 0.8</ambient>
            <diffuse>0.2 1.0 0.2 0.8</diffuse>
            <emissive>0 0.3 0 1</emissive>
          </material>
        </visual>

        <!-- Direction Indicator (Front arrow) -->
        <visual name="direction_indicator">
          <pose>0.35 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.02 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <emissive>0.5 0.5 0 1</emissive>
          </material>
        </visual>

        <!-- Collision Geometry (Simplified) -->
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
        </collision>
      </link>

      <!-- Gazebo Physics Plugin for ROS2 Integration -->
      <plugin name="simple_drone_plugin" filename="libsimple_drone_plugin.so">
        <namespace>agent_0</namespace>
      </plugin>
    </model>

    <!-- Target Position Marker (Glowing Cylinder) -->
    <model name="target_marker">
      <pose>5 5 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <!-- Main Target Disc -->
        <visual name="target_disc">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <emissive>0 0.5 0 1</emissive>
          </material>
        </visual>
        <!-- Target Glow Halo -->
        <visual name="target_halo">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 0.3</ambient>
            <diffuse>0 1 0 0.3</diffuse>
            <emissive>0 0.3 0 0.5</emissive>
          </material>
        </visual>
        <!-- Vertical Beam (Visibility Aid) -->
        <visual name="target_beam">
          <pose>0 0 -0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 0.5</ambient>
            <diffuse>0 1 0 0.5</diffuse>
            <emissive>0 0.3 0 0.5</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Workspace Boundaries (Visual Only) -->
    <model name="workspace_boundary">
      <pose>0 0 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <!-- 10m x 10m workspace visualization -->
        <visual name="boundary_x_positive">
          <pose>5 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 10 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 0.2</ambient>
            <diffuse>1 0.5 0 0.2</diffuse>
          </material>
        </visual>
        <visual name="boundary_x_negative">
          <pose>-5 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 10 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 0.2</ambient>
            <diffuse>1 0.5 0 0.2</diffuse>
          </material>
        </visual>
        <visual name="boundary_y_positive">
          <pose>0 5 0 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.05 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 0.2</ambient>
            <diffuse>1 0.5 0 0.2</diffuse>
          </material>
        </visual>
        <visual name="boundary_y_negative">
          <pose>0 -5 0 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.05 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 0.2</ambient>
            <diffuse>1 0.5 0 0.2</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- GUI Configuration -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-8 -8 10 0 0.6 0.785</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
