<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agent_control_pkg</name>
  <version>0.0.0</version>
  <description>Package for individual agent control including PID and Fuzzy Logic.</description>
  <maintainer email="ataka@example.com">Atakan YAMAN</maintainer>
  <license>Apache License 2.0</license> <!-- Or your chosen license -->

  <!-- These will be important for ROS2 build -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <depend>my_custom_interfaces_pkg</depend>

  <!-- Crazyflie/Crazyswarm2 support - always available, activated with -DENABLE_CRAZYFLIE=ON -->
  <exec_depend>crazyflie_interfaces</exec_depend>

  <!-- Python dependencies for wind_turbulence_models.py (vonkarman/dryden) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
