<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    Wind Flag Model with Dynamic Wind Indicator Plugin
    The flag rotates based on /wind/velocity ROS2 topic
  -->
  <model name="wind_flag">
    <static>false</static>

    <!-- Fixed base/pole - doesn't rotate -->
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>100</mass>
        <inertia>
          <ixx>100</ixx><iyy>100</iyy><izz>100</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Pole -->
      <visual name="pole">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>4.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <!-- Base plate -->
      <visual name="base_plate">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <collision name="base_collision">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Rotating flag/sock assembly -->
    <link name="flag">
      <pose>0 0 3.8 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.1</iyy><izz>0.1</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Windsock cone - orange/red stripes -->
      <visual name="sock_1">
        <pose>0.3 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0.4 0 1</ambient>
          <diffuse>1 0.5 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="sock_2">
        <pose>0.6 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <visual name="sock_3">
        <pose>0.85 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0.4 0 1</ambient>
          <diffuse>1 0.5 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="sock_4">
        <pose>1.1 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <visual name="sock_tip">
        <pose>1.3 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0.3 0 1</ambient>
          <diffuse>1 0.4 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Arrow direction indicator at base of sock -->
      <visual name="direction_arrow">
        <pose>-0.15 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0.5 1 1</ambient>
          <diffuse>0.1 0.6 1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Joint connecting flag to pole (rotates around Z) -->
    <joint name="flag_joint" type="revolute">
      <parent>base</parent>
      <child>flag</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.15</lower>
          <upper>3.15</upper>
        </limit>
        <dynamics>
          <damping>0.5</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Wind flag plugin - rotates flag based on wind direction -->
    <plugin name="wind_flag_plugin" filename="libwind_flag_plugin.so">
      <joint_name>flag_joint</joint_name>
      <wind_topic>/wind/velocity</wind_topic>
      <update_rate>10</update_rate>
    </plugin>
  </model>
</sdf>
