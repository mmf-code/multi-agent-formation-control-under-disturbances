<?xml version="1.0"?>
<model>
  <name>Wind Flag</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Formation Control Project</name>
  </author>
  <description>
    Dynamic wind flag/windsock that rotates based on wind direction.
    Subscribes to /wind/velocity ROS topic.
    Orange/white striped for visibility.
  </description>
</model>
