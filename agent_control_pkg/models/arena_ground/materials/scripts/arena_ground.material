// Professional Robotics Arena Ground Material
// Pure white floor with subtle grid for video recording

material ArenaGround/Grid
{
  technique
  {
    pass
    {
      // Pure white floor
      ambient 1.0 1.0 1.0 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.1 0.1 0.1 1.0 4.0

      texture_unit
      {
        texture arena_grid.png
        // Fine grid scaling
        scale 0.1 0.1
        filtering trilinear
      }
    }
  }
}
