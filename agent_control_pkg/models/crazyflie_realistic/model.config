<?xml version="1.0"?>
<model>
  <name>Crazyflie 2.1 Realistic</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Multi-Agent Formation Control Team</name>
    <email>research@example.com</email>
  </author>

  <description>
    Crazyflie 2.1 nano quadrotor with realistic motor physics from sim_cf2.

    Features:
    - Calibrated motor dynamics (k=1.28e-8 kg.m/s²)
    - Asymmetric time constants (12.5ms up, 25ms down)
    - Realistic thrust-to-weight ratio
    - Hardware-transferable simulation results

    Physical specifications:
    - Mass: 25g (0.025 kg) body + 3g propellers
    - Size: 92mm x 92mm (motor-to-motor)
    - Arm length: 32.5mm
    - Max thrust: ~60g (0.6N)

    Reference: https://github.com/CrazyflieTHI/sim_cf2
  </description>
</model>
